# Database Connection (AWS RDS MySQL in Production)
DATABASE_URL="mysql://<RDS_USER>:<RDS_PASSWORD>@<RDS_ENDPOINT>:3306/<DATABASE_NAME>"

# Authentication Secret
JWT_SECRET="generate-a-strong-random-secret-key"

# AWS S3 Configuration for Student Passport Uploads
AWS_REGION="us-east-1"
AWS_S3_BUCKET="student-portal-passports-prod"
AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
